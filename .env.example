# ============================================================
# VISIONATTEND AI - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# Server Settings
PORT=5000
FLASK_ENV=production

# Core Security & Cryptography
SECRET_KEY=generate-a-strong-random-secret-key-32-chars-minimum
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-32-chars-minimum
BIOMETRIC_MASTER_KEY=generate-a-strong-aes-256-master-biometric-key

# Relational Database Connection (PostgreSQL or SQLite)
# For SQLite (default local):
DATABASE_URL=sqlite:///attendance_enterprise.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

# AI Biometric Thresholds
FACE_MATCH_THRESHOLD=0.62
LIVENESS_BLUR_THRESHOLD=85.0

# Attendance Rules Engine
DEFAULT_GRACE_PERIOD_MINS=10
DEFAULT_LATE_CUTOFF_MINS=30
DEFAULT_MIN_PRESENCE_MINS=45
DUPLICATE_RECOGNITION_COOLDOWN_SECS=180
LOW_ATTENDANCE_THRESHOLD_PERCENT=75.0
